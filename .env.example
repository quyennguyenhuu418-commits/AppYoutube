# =====================================================
# AI Documentary Animation Factory - Environment Config
# =====================================================
# Copy this file to `.env` and fill in the values you have.
# Anything left blank will fall back to a mock implementation
# so the system still runs end-to-end for a demo.

# ---------- Core ----------
APP_ENV=dev
LOG_LEVEL=INFO
WORKSPACE_DIR=./workspace
DATABASE_URL=sqlite:///./workspace/app.db

# CORS - comma-separated list of allowed origins for the webapp
CORS_ORIGINS=http://localhost:3000

# ---------- OpenAI (LLM + DALL-E) ----------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_LLM_MODEL_LARGE=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3

# ---------- ElevenLabs (TTS) ----------
# https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---------- Renderer ----------
# Path to the Node renderer CLI. Leave default unless you moved it.
RENDERER_DIR=./renderer
RENDERER_ENTRY=npx tsx src/index.ts

# ---------- Video defaults ----------
DEFAULT_FPS=30
DEFAULT_WIDTH=1920
DEFAULT_HEIGHT=1080
TARGET_DURATION_SEC=120

# ---------- Cache ----------
# 'always' (default), 'never', 'missing-only'
CACHE_MODE=always

# ---------- Research Intelligence Engine ----------
# Max sources to collect per research job
RESEARCH_MAX_SOURCES=50
# Max claims to extract per research job
RESEARCH_MAX_CLAIMS=200
# Stop researching when marginal gain drops below this threshold (0-1)
RESEARCH_STOP_MARGIN_GAIN=0.05
# Below this overall quality score, emit a warning (0-1)
RESEARCH_QUALITY_MIN_THRESHOLD=0.6
# LLM model used for research synthesis and claim extraction
RESEARCH_LLM_MODEL=gpt-4o
# LLM temperature for research operations (lower = more deterministic)
RESEARCH_TEMPERATURE=0.3
# Research cache TTL in days
RESEARCH_CACHE_TTL_DAYS=7

# =====================================================
# AI VIDEO GENERATION (B-roll footage) - Sep 2026
# =====================================================
# Stage TÙY CHỌN (mặc định OFF). Bật VIDEO_ASSETS_ENABLED=true nếu muốn
# sinh video B-roll 5-8s cho mỗi environment bằng AI.
#
# VIDEO_PROVIDER có các giá trị:
#   multi  (mặc định) - tự động fallback giữa các provider
#   kivest - chỉ dùng Kivest (FREE, 4 video/ngày)
#   veo    - chỉ dùng Google Veo 3.1 (PAID)
#   kling  - chỉ dùng Kling (FREE limited, 66 credits/tháng)
#
# VIDEO_PROVIDER_PRIORITY: CSV thứ tự fallback, ví dụ "kivest,kling,veo"

# ---------- General ----------
VIDEO_ASSETS_ENABLED=false
VIDEO_ASSETS_DURATION_SEC=5
VIDEO_ASSETS_ASPECT_RATIO=16:9
VIDEO_ASSETS_QUALITY=draft             # draft (rẻ) | standard | high

VIDEO_PROVIDER=multi
VIDEO_PROVIDER_PRIORITY=kivest,veo,kling

# ---------- Kivest AI (FREE - https://ai.ezif.in/docs) ----------
# 1 RPM, 4 RPD. Đăng nhập Google để lấy key.
KIVEST_API_KEY=
KIVEST_BASE_URL=https://ai.ezif.in
# Để trống → tự chọn theo quality (veo/grok/qwen). Override nếu muốn:
# KIVEST_MODEL=veo-3.1
# KIVEST_MODEL=grok-video
# KIVEST_MODEL=qwen-video

# ---------- Google Veo 3.1 (PAID - https://aistudio.google.com/apikey) ----------
# Dùng chung GEMINI_API_KEY ở trên (đã có sẵn). Tier 1 = 10 video/ngày.
# Để trống VEO_MODEL → dùng veo-3.1-fast-generate-preview (draft) hoặc veo-3.1-generate-001 (high)
# VEO_MODEL=veo-3.1-fast-generate-preview
# VEO_MODEL=veo-3.1-generate-001

# ---------- Kling AI (FREE limited - https://klingai.com) ----------
# 66 credits/tháng. Free tier cấm thương mại.
# Format mới: 1 API key đơn lẻ (Bearer token)
KLING_API_KEY=
# Format cũ (AK/SK pair - sẽ tự ghép thành "ak-sk"):
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
# Để trống → dùng kling-v3-std. Override:
# KLING_MODEL=kling-v2
# KLING_MODEL=kling-v3-pro
