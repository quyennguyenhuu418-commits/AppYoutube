# =====================================================
# AI Documentary Animation Factory - Environment Config
# =====================================================
# Copy this file to `.env` and fill in the values you have.
# Anything left blank will fall back to a mock implementation
# so the system still runs end-to-end for a demo.

# ---------- Core ----------
APP_ENV=dev
LOG_LEVEL=INFO
WORKSPACE_DIR=./workspace
DATABASE_URL=sqlite:///./workspace/app.db

# CORS - comma-separated list of allowed origins for the webapp
CORS_ORIGINS=http://localhost:3000

# ---------- OpenAI (LLM + DALL-E) ----------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_LLM_MODEL_LARGE=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3

# ---------- ElevenLabs (TTS) ----------
# https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---------- Renderer ----------
# Path to the Node renderer CLI. Leave default unless you moved it.
RENDERER_DIR=./renderer
RENDERER_ENTRY=npx tsx src/index.ts

# ---------- Video defaults ----------
DEFAULT_FPS=30
DEFAULT_WIDTH=1920
DEFAULT_HEIGHT=1080
TARGET_DURATION_SEC=120

# ---------- Cache ----------
# 'always' (default), 'never', 'missing-only'
CACHE_MODE=always

# ---------- Research Intelligence Engine ----------
# Max sources to collect per research job
RESEARCH_MAX_SOURCES=50
# Max claims to extract per research job
RESEARCH_MAX_CLAIMS=200
# Stop researching when marginal gain drops below this threshold (0-1)
RESEARCH_STOP_MARGIN_GAIN=0.05
# Below this overall quality score, emit a warning (0-1)
RESEARCH_QUALITY_MIN_THRESHOLD=0.6
# LLM model used for research synthesis and claim extraction
RESEARCH_LLM_MODEL=gpt-4o
# LLM temperature for research operations (lower = more deterministic)
RESEARCH_TEMPERATURE=0.3
# Research cache TTL in days
RESEARCH_CACHE_TTL_DAYS=7
